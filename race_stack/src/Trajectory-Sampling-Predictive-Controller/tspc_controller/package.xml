<?xml version="1.0"?>
<package format="3">
  <name>tspc_controller</name>
  <version>0.1.0</version>
  <description>ROS2 TSPC controller with trajectory sampling, raceline tracking, and LiDAR-reactive obstacle avoidance.</description>

  <maintainer email="mae00018@mix.wvu.edu">Mohamed Elgouhary</maintainer>
  <license>TODO: Choose a license</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>stack_master</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
